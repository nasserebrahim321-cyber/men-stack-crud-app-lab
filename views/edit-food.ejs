<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=], initial-scale=1.0">
    <title>edit-food</title>
</head>

<body>
    <h1>Edit-Food</h1>
    <form action="/foods/<%= food.id %>/?_method=PUT" method="post">
        <label for="name">Name :</label>
        <input type="text" name="name" id="name" value="<%= food.name %>">

        <label for="description">Description :</label>
        <input type="text" name="description" id="description" value="<%= food.description %>">

        <label for="image">Image :</label>
        <input type="text" name="image" id="image" value="<%= food.image %>">

        <button>UPDATE</button>
    </form>

</body>

</html>